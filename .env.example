# ==============================================================================
# Bangkok Weather Resilience AI - Environment Configuration
# Phase 1: Go Gateway + Python AI Engine + Redis Cache
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud & Vertex AI Configuration
# ------------------------------------------------------------------------------
# Option 1: Direct Gemini API Key (e.g. from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Google Cloud Vertex AI (Service Account)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------------------------
# Weather Models & APIs (Google WeatherNext 3 / Maps Platform)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_WEATHER_API_KEY=your_google_weather_api_key
WEATHER_DATA_MODE=mock  # Options: 'mock' (offline simulation) or 'live' (real API)

# ------------------------------------------------------------------------------
# Thailand Local Telemetry APIs (BMA / ThaiWater)
# ------------------------------------------------------------------------------
THAIWATER_API_KEY=your_thaiwater_api_key
THAIWATER_DATA_MODE=mock # Options: 'mock' or 'live'
BMA_RADAR_DATA_MODE=mock  # Options: 'mock' or 'live'

# ------------------------------------------------------------------------------
# LINE Official Account Configuration
# ------------------------------------------------------------------------------
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_TOKEN=your_line_channel_access_token
LIFF_ENDPOINT_URL=https://liff.line.me/your-liff-id

# ------------------------------------------------------------------------------
# Redis Cache & Message Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Service Ports & Networking
# ------------------------------------------------------------------------------
PORT=8080
GATEWAY_PORT=8080
ENGINE_PORT=8000
ENGINE_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Optional Storage (PostgreSQL with PostGIS - Phase 2)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_bkk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
